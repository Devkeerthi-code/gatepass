# ---- Database (Neon Postgres) ----
# Pooled connection string used by the app at runtime (Neon dashboard → Connection details → Pooled).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection used only by `prisma migrate`. Same as above without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Tests run against an isolated schema so they never touch app data. Use the direct URL + schema=.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?schema=gatepass_test&sslmode=verify-full"

# ---- App ----
# Public base URL. Used for webhook URLs, invite links, calendar links and the Live readiness check (must be https:// for Live).
APP_URL="http://localhost:3000"

# ---- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----
# 32 random bytes, base64. Encrypts hosts' Razorpay secrets at rest (AES-256-GCM). Changing it makes saved keys unreadable.
APP_ENCRYPTION_KEY=""
# At least 32 characters. Signs ticket QR codes (HMAC-SHA256). Changing it invalidates every issued QR.
TICKET_SIGNING_SECRET=""
# At least 16 characters. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/release-holds.
CRON_SECRET=""
# At least 16 characters. Root secret for the Mock payment provider's checkout and webhook signatures.
MOCK_PAYMENT_SECRET=""

# ---- Razorpay (optional) ----
# Leave empty to use Mock payments. Hosts can also paste their own keys in Settings → Payments,
# which takes priority over these app-wide keys for their concerts.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret you set when creating the webhook (payment.captured) pointing at $APP_URL/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ---- Email (optional) ----
# Resend (https://resend.com, free tier) for ticket and invite emails. Leave empty to skip email;
# buyers still get their ticket links on screen and via "Find my tickets".
RESEND_API_KEY=""
# Verified sender, e.g. "GatePass <tickets@yourdomain.in>"
EMAIL_FROM=""

# ---- Demo seed (optional) ----
# `npm run db:seed` creates a clearly labelled DEMO concert. Demo logins are only created if you set
# these emails (use your own addresses). Passwords: set them here, or leave empty to get random ones printed once.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_VOLUNTEER_EMAIL=""
SEED_VOLUNTEER_PASSWORD=""
